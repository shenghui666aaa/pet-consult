page {
  background-color: #f7f8fa;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

/* 主按钮 */
.btn-primary {
  background: #4f7cff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.btn-primary[disabled] {
  background: #b9c6ff;
  color: #fff;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
