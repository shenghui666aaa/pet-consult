.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 600;
}

.pet-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.symptom {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
}

.img-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.loading-card {
  text-align: center;
  padding: 60rpx 28rpx;
}

.loading-emoji {
  font-size: 80rpx;
}

.loading-text {
  margin-top: 16rpx;
  color: #999;
  font-size: 28rpx;
}

.ai-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4f7cff;
  margin-bottom: 16rpx;
}

.ai-line {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
}
