<view class="page">
  <view class="card">
    <view class="pet-name">{{consult.pet.name || '宠物'}}</view>
    <view class="pet-meta">{{consult.pet.species}} · {{consult.pet.breed}}</view>
    <view class="symptom">症状：{{consult.symptom}}</view>
    <view class="img-row" wx:if="{{imageUrls.length > 0}}">
      <image class="img" wx:for="{{imageUrls}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" />
    </view>
  </view>

  <view class="card loading-card" wx:if="{{!done}}">
    <view class="loading-emoji">🩺</view>
    <view class="loading-text">AI 正在分诊，请稍候…</view>
  </view>

  <view class="card" wx:else>
    <view class="ai-title">分诊结果</view>
    <view class="ai-line" wx:for="{{aiLines}}" wx:key="index">{{item}}</view>
  </view>
</view>
