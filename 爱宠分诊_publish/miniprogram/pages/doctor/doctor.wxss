.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.consult-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 600;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-pending {
  background: #fff4e6;
  color: #e8890c;
}

.status-accepted {
  background: #e7f5ff;
  color: #1c7ed6;
}

.status-closed {
  background: #f0f1f5;
  color: #999;
}

.symptom {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.time {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
}

.actions {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.btn-accept {
  background: #2f9e44;
  color: #fff;
}

.btn-chat {
  background: #4f7cff;
  color: #fff;
}
