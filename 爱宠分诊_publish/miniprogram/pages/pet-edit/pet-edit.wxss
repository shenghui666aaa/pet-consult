.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.photo-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
}

.photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f1f5;
  font-size: 80rpx;
  color: #bbb;
}

.photo-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.save {
  margin-top: 24rpx;
}
