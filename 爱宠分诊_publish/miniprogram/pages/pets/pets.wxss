.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.pet-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.pet-photo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f0f1f5;
}

.pet-photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.pet-info {
  flex: 1;
  margin-left: 24rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 600;
}

.pet-meta {
  font-size: 26rpx;
  color: #999;
  margin-top: 6rpx;
}

.pet-arrow {
  color: #ccc;
  font-size: 40rpx;
}

.footer {
  margin-top: 32rpx;
}

.btn-ghost {
  background: #fff;
  color: #4f7cff;
  border: 1rpx solid #4f7cff;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-top: 20rpx;
}
