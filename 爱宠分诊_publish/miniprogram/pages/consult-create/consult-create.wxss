.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.form-item {
  padding: 16rpx 8rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.picker {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.placeholder {
  color: #999;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.textarea {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 8rpx;
}

.img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.img-del {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 44rpx;
  font-size: 30rpx;
}

.img-add {
  width: 200rpx;
  height: 200rpx;
  background: #f0f1f5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #bbb;
}

.submit {
  margin-top: 40rpx;
}
