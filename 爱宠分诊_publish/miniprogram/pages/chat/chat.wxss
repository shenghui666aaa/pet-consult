.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f8fa;
}

.consult-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 600;
}

.status {
  font-size: 24rpx;
  color: #1c7ed6;
}

.msg-list {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row.mine {
  justify-content: flex-end;
}

.msg-row.theirs {
  justify-content: flex-start;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  word-break: break-all;
}

.bubble-mine {
  background: #4f7cff;
  color: #fff;
}

.bubble-theirs {
  background: #fff;
  color: #333;
}

.msg-img {
  max-width: 400rpx;
  border-radius: 12rpx;
}

.msg-text {
  display: inline-block;
}

.empty-tip {
  text-align: center;
  color: #bbb;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.icon-btn {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.input {
  flex: 1;
  background: #f2f3f5;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  background: #4f7cff;
  color: #fff;
}
