<view class="page">
  <view class="hero">
    <view class="hero-title">爱宠分诊</view>
    <view class="hero-sub">描述症状，AI 智能分诊</view>
  </view>

  <view class="role-row">
    <view class="role-card" bindtap="goOwner">
      <view class="role-emoji">🐶</view>
      <view class="role-name">宠物档案</view>
      <view class="role-desc">添加宠物、发起问诊</view>
    </view>
    <view class="role-card" bindtap="goList">
      <view class="role-emoji">💬</view>
      <view class="role-name">我的问诊</view>
      <view class="role-desc">查看分诊记录</view>
    </view>
  </view>

  <view class="tip" wx:if="{{openid}}">
    已连接后端服务，openid: {{openid}}
  </view>
  <view class="tip tip-error" wx:else>
    尚未连通后端，请先启动 server（cd server 后 npm install 再 npm start）
  </view>
</view>
